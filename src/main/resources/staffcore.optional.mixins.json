{
  "_comment": [
    "Nice-to-have hooks: command spy, block-place logging and vanished item pickup.",
    "Both target methods whose signatures move more often than PlayerList#canPlayerLogin,",
    "so this config is deliberately non-fatal. If one stops applying after a Minecraft",
    "update the server still boots and the rest of StaffCore keeps working \u2014 you lose",
    "only the affected feature until the injection point is fixed."
  ],
  "required": false,
  "package": "io.github.alphain24.staffcore.mixin",
  "mixins": [
    "BlockItemMixin",
    "ChunkSendMixin",
    "CommandsMixin",
    "ContainerCloseMixin",
    "ExplosionMixin",
    "FireSpreadMixin",
    "InventoryDropMixin",
    "ItemEntityMixin",
    "ItemPickupMixin",
    "PlayerDropMixin",
    "SpectatorMenuMixin",
    "VanishJoinMixin",
    "VanishLeaveMixin",
    "vanish.VanishArrowMixin",
    "vanish.VanishBlockEventMixin",
    "vanish.VanishBroadcastMixin",
    "vanish.VanishChunkTicketMixin",
    "vanish.VanishCollisionMixin",
    "vanish.VanishLivingCollisionMixin",
    "vanish.VanishGameEventMixin",
    "vanish.VanishListMixin",
    "vanish.VanishMobTargetMixin",
    "vanish.VanishNearestPlayerMixin",
    "vanish.VanishPickupMixin",
    "vanish.VanishPlayerListCommandMixin",
    "vanish.VanishPressurePlateMixin",
    "vanish.VanishProjectileMixin",
    "vanish.VanishSelectorMixin",
    "vanish.VanishSleepMixin",
    "vanish.VanishSoundMixin",
    "vanish.VanishSpawnChunkMixin",
    "vanish.VanishStatusMixin",
    "vanish.VanishSweepMixin",
    "vanish.VanishTrialSpawnerMixin",
    "vanish.VanishWaypointMixin"
  ],
  "injectors": {
    "defaultRequire": 0
  }
}
